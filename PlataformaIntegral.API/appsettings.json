{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "PlataformaIntegralDB": "Server=localhost,1433;Database=PlataformaIntegralDB;User Id=CAMBIAR_DB_USER;Password=CAMBIAR_DB_PASSWORD;TrustServerCertificate=True;"
  },

  "Jwt": {
    "Key": "CLAVE_JWT_SECRETA_CAMBIAR",
    "Issuer": "PlataformaIntegralAPI",
    "Audience": "PlataformaIntegralApps"
  },

  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "CAMBIAR_MINIO_ACCESS_KEY",
    "SecretKey": "CAMBIAR_MINIO_SECRET_KEY",
    "Secure": false,
    "Buckets": {
      "Videos": "videos",
      "Documents": "documentos",
      "Users": "usuarios",
      "Resources": "otros-recursos",
      "Miniaturas": "miniaturas"
    }
  }
}
